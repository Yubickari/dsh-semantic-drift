{
  "name": "dsh-semantic-drift",
  "version": "0.1.0",
  "description": "One versioned vocabulary file, one read-only scanner, one panel: see where the same concept is spelled several ways across a codebase.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "icon.svg",
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.3",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "vocabulary",
    "semantic-drift",
    "code-review"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  }
}

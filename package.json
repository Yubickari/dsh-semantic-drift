{
  "name": "dsh-semantic-drift",
  "version": "0.1.3",
  "description": "One versioned vocabulary of a project's business concepts, a read-only drift scan, and the same naming rules in every agent prompt. A DSH plugin.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsc --noEmit && node --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node scripts/build.mjs && tsc --noEmit && node --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "release:check": "node scripts/preflight.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "vocabulary",
    "semantic-drift",
    "code-review"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yubickari/dsh-semantic-drift.git"
  },
  "homepage": "https://github.com/Yubickari/dsh-semantic-drift#readme",
  "bugs": {
    "url": "https://github.com/Yubickari/dsh-semantic-drift/issues"
  },
  "author": "Yubickari",
  "packageManager": "pnpm@11.18.0"
}
